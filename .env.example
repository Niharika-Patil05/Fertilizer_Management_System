# ============================================================================
#  Fertilizer Management System - deployment configuration
#  Copy this file to ".env" (start.bat does this automatically on first run).
#  NEVER commit the real ".env" - it is git-ignored.
# ============================================================================

# ---- versions ----
# The application version to run. update.bat rewrites this line.
APP_VERSION=1.0.0
# MongoDB server image tag (Mongoose 8 supports MongoDB 6 and 7).
MONGO_IMAGE_TAG=7

# ---- GHCR image owner (developer sets this before publishing / sponsor leaves as-is) ----
IMAGE_OWNER=niharika-patil05

# ---- host ports ----
# The only port exposed on the sponsor's machine. Open http://localhost:<this>
# Change it if 8080 is already in use.
FRONTEND_PORT=8080

# ---- backend ----
NODE_ENV=production
PORT=5000
# "mongo" is the docker-compose service name - do not change unless you know why.
MONGO_URI=mongodb://mongo:27017/fertilizer_mgmt
# Signing key for login tokens. start.bat generates a random value on first run.
# If you change this, every logged-in user is signed out. Keep it secret, keep it stable.
JWT_SECRET=CHANGE_ME_generated_on_first_run
# How long a login stays valid.
JWT_EXPIRE=30d
# Comma-separated allowed browser origins. Blank = reflect the request origin,
# which is correct for this single-origin localhost deployment.
CORS_ORIGIN=

# ---- first-run setup ----
# No account is pre-created. When the database has zero users, the login
# screen shows a "Create Your Account" form so the sponsor picks their own
# email and password directly in the browser — nothing to configure here.
